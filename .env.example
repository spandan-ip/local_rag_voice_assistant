# Copy this file to `.env` and adjust values as needed.
# main.py / app/config.py will automatically load `.env` if present.

# --- LLM (Ollama) ---
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
TEMPERATURE=0.1

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking ---
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=6

# --- Paths (usually fine to leave as defaults) ---
# SOURCE_DIR=source
# VECTOR_STORE_DIR=vector_store
